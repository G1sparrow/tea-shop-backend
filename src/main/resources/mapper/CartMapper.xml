<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teashop.mapper.CartMapper">

    <resultMap id="CartResultMap" type="com.teashop.common.entity.Cart">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="findById" resultMap="CartResultMap">
        SELECT * FROM carts WHERE id = #{id}
    </select>

    <select id="findByUser" resultMap="CartResultMap">
        SELECT * FROM carts WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <select id="findByUserAndProduct" resultMap="CartResultMap">
        SELECT * FROM carts WHERE user_id = #{userId} AND product_id = #{productId}
    </select>

    <insert id="insert" parameterType="com.teashop.common.entity.Cart" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO carts (user_id, product_id, quantity, create_time, update_time)
        VALUES (#{user.id}, #{product.id}, #{quantity}, NOW(), NOW())
    </insert>

    <update id="update" parameterType="com.teashop.common.entity.Cart">
        UPDATE carts
        SET quantity = #{quantity},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM carts WHERE id = #{id}
    </delete>

    <delete id="deleteByUser">
        DELETE FROM carts WHERE user_id = #{userId}
    </delete>

    <delete id="deleteByUserAndProductId">
        DELETE FROM carts WHERE user_id = #{userId} AND product_id = #{productId}
    </delete>

</mapper>
