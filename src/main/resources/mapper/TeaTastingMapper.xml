<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teashop.mapper.TeaTastingMapper">

    <resultMap id="TeaTastingResultMap" type="com.teashop.common.entity.TeaTasting">
        <id column="id" property="id" />
        <result column="product_id" property="product.id" />
        <result column="fragrance" property="fragrance" />
        <result column="taste" property="taste" />
        <result column="steep_resistance" property="steepResistance" />
        <result column="suitable_tea_set" property="suitableTeaSet" />
        <result column="brewing_suggestion" property="brewingSuggestion" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <select id="findById" resultMap="TeaTastingResultMap">
        SELECT * FROM tea_tasting WHERE id = #{id}
    </select>

    <select id="findByProductId" resultMap="TeaTastingResultMap">
        SELECT * FROM tea_tasting WHERE product_id = #{productId}
    </select>

    <insert id="insert" parameterType="com.teashop.common.entity.TeaTasting">
        INSERT INTO tea_tasting (
            product_id, fragrance, taste, steep_resistance, 
            suitable_tea_set, brewing_suggestion
        ) VALUES (
            #{product.id}, #{fragrance}, #{taste}, #{steepResistance}, 
            #{suitableTeaSet}, #{brewingSuggestion}
        )
    </insert>

    <update id="update" parameterType="com.teashop.common.entity.TeaTasting">
        UPDATE tea_tasting SET 
            fragrance = #{fragrance},
            taste = #{taste},
            steep_resistance = #{steepResistance},
            suitable_tea_set = #{suitableTeaSet},
            brewing_suggestion = #{brewingSuggestion},
            update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM tea_tasting WHERE id = #{id}
    </delete>

</mapper>
