<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teashop.mapper.BrewingGuideMapper">

    <resultMap id="BrewingGuideResultMap" type="com.teashop.common.entity.BrewingGuide">
        <id column="id" property="id" />
        <result column="product_id" property="product.id" />
        <result column="water_temperature" property="waterTemperature" />
        <result column="tea_amount" property="teaAmount" />
        <result column="brewing_time" property="brewingTime" />
        <result column="brewing_times" property="brewingTimes" />
        <result column="tea_set_recommendation" property="teaSetRecommendation" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
    </resultMap>

    <select id="findById" resultMap="BrewingGuideResultMap">
        SELECT * FROM brewing_guide WHERE id = #{id}
    </select>

    <select id="findByProductId" resultMap="BrewingGuideResultMap">
        SELECT * FROM brewing_guide WHERE product_id = #{productId}
    </select>

    <insert id="insert" parameterType="com.teashop.common.entity.BrewingGuide">
        INSERT INTO brewing_guide (
            product_id, water_temperature, tea_amount, 
            brewing_time, brewing_times, tea_set_recommendation
        ) VALUES (
            #{product.id}, #{waterTemperature}, #{teaAmount}, 
            #{brewingTime}, #{brewingTimes}, #{teaSetRecommendation}
        )
    </insert>

    <update id="update" parameterType="com.teashop.common.entity.BrewingGuide">
        UPDATE brewing_guide SET 
            water_temperature = #{waterTemperature},
            tea_amount = #{teaAmount},
            brewing_time = #{brewingTime},
            brewing_times = #{brewingTimes},
            tea_set_recommendation = #{teaSetRecommendation},
            update_time = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM brewing_guide WHERE id = #{id}
    </delete>

</mapper>
